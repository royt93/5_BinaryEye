<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/roy_bg_sheet_root"
    android:paddingBottom="28dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="#55FFFFFF"/>

    <!-- Hero icon stack: halo glow + colored circle + symbol icon + lottie overlay -->
    <FrameLayout
        android:id="@+id/sheetIconStack"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:layout_marginBottom="14dp"
        android:clipChildren="false">

        <!-- Soft halo behind -->
        <View
            android:id="@+id/sheetHalo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/roy_bg_sheet_icon_halo"
            android:layout_gravity="center"/>

        <!-- Colored circle -->
        <FrameLayout
            android:id="@+id/sheetIconCircle"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/roy_bg_sheet_icon_success">

            <ImageView
                android:id="@+id/ivSheetIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle_filled"
                android:importantForAccessibility="no"/>
        </FrameLayout>

        <!-- Lottie confetti overlay (only success) -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_rawRes="@raw/anim_confetti"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:text="Title"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.01"/>

    <TextView
        android:id="@+id/tvSheetMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="28dp"
        android:text="Message"
        android:gravity="center"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#CCFFFFFF"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="20dp"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSheetNegative"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:text="Không"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/roy_bg_btn_outline_white"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp"
            android:visibility="gone"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSheetPositive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:text="Đồng ý"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/roy_bg_btn_gradient_gold"
            android:stateListAnimator="@null"
            android:layout_marginStart="8dp"/>

    </LinearLayout>
</LinearLayout>
