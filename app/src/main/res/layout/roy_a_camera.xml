<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <de.markusfisch.android.cameraview.widget.CameraView
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.mckimquyen.binaryeye.view.widget.DetectorView
        android:id="@+id/detectorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <include layout="@layout/roy_v_toolbar" />

        <!-- [FEAT VIP-02] Badge dem so luong khi Audit Mode dang bat, tap de mo summary -->
        <com.google.android.material.chip.Chip
            android:id="@+id/auditBadge"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/audit_badge_placeholder"
            android:visibility="gone"
            app:chipIcon="@drawable/ic_action_history"
            app:layout_anchor="@id/toolbar"
            app:layout_anchorGravity="bottom|end"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <!-- Glass container for controls only -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_liquid_glass_dark"
                android:padding="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:elevation="12dp">

                <SeekBar
                    android:id="@+id/zoom"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom|start"
                    android:layout_weight="1" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/flash"
                    style="@style/FAB"
                    android:contentDescription="@string/toggle_flash"
                    android:src="@drawable/ic_action_flash" />
            </LinearLayout>

            <include
                android:id="@+id/layoutAdBanner"
                layout="@layout/layout_ad_banner" />
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</merge>
