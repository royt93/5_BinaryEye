<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass FAB with circular glassmorphism -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#20000000" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>

    <!-- Glass background -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- Glass border -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
